APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://your-subdomain.trycloudflare.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=7800

CACHE_STORE=database
# CACHE_PREFIX=

TRUSTED_PROXIES=*
TRUSTED_HOSTS=.trycloudflare.com
CSRF_TRUSTED_HOSTS=.trycloudflare.com

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT=7200
FFMPEG_THREADS=4
FFMPEG_PRESET=veryfast
FFMPEG_VIDEO_ENCODER=libx264
VIDEO_RENDITIONS=1080,720,480,360
VIDEO_PROCESSING_QUEUE=video-processing
HLS_SEGMENT_SECONDS=6
HLS_SIGNED_URL_MINUTES=10
HLS_AUDIO_BITRATE=128
HLS_UPLOAD_CONCURRENCY=12

# Paymob Accept (use sandbox credentials while APP_ENV=local)
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC=
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMENT_ALERT_EMAIL=
PAYMENT_STALE_PENDING_MINUTES=30
PAYMOB_IFRAME_ID=
PAYMOB_INTEGRATION_CARD_ID=
PAYMOB_INTEGRATION_WALLET_ID=
PAYMOB_VERIFY_HMAC=true

VITE_APP_NAME="${APP_NAME}"
# VITE_HMR_HOST=your-subdomain.trycloudflare.com
# VITE_HMR_PORT=443
# VITE_HMR_PROTOCOL=https

# Public images and attachments
R2_PUBLIC_ENDPOINT=
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PUBLIC_REGION=auto
R2_PUBLIC_URL=

# Private source videos and HLS (disable public access in Cloudflare)
R2_PRIVATE_ENDPOINT=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PRIVATE_REGION=auto
